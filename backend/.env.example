# ── 数据库配置 ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=ai_github

# ── DeepSeek API（可选）────────────────────────────────
# 不填：自动降级为 Google 免费翻译
# 获取：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── GitHub Token（可选）────────────────────────────────
# 不填：60次请求/小时（每天跑一次完全够用）
# 填写：5000次请求/小时（数据更丰富）
# 获取：https://github.com/settings/tokens → Generate new token (classic)
# 权限：不需要勾选任何权限（读公开仓库默认可用）
GITHUB_TOKEN=

# ── 爬取配置 ────────────────────────────────────────────
# topic 搜索最低 Star 数（默认 500）
MIN_STARS_TOPIC=500
# 关键词搜索最低 Star 数（默认 200）
MIN_STARS_KEYWORD=200

# ── API 服务配置 ────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
